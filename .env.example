# Copy to .env (docker compose reads it) — and never commit the real .env.
CAFE_DB_PASSWORD=change-me
# 32+ random characters. Generate one:  openssl rand -base64 48
CAFE_JWT_SECRET=
CAFE_OWNER_NAME=Owner
CAFE_OWNER_EMAIL=owner@cafe.local
# Leave blank to have a random password printed once in the API log on first start.
CAFE_OWNER_PASSWORD=
# true when served over HTTPS
CAFE_COOKIE_SECURE=false
